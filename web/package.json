{
  "name": "senko-web",
  "version": "0.46.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "panda codegen && vite dev",
    "build": "panda codegen && vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "panda codegen && tsc --noEmit",
    "panda:codegen": "panda codegen",
    "gen:api": "openapi-typescript ../docs/openapi/openapi.json -o src/api/types.gen.ts",
    "test": "panda codegen && vitest run",
    "test:watch": "panda codegen && vitest",
    "e2e": "panda codegen && playwright test",
    "e2e:ui": "panda codegen && playwright test --ui",
    "e2e:headed": "panda codegen && playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@ark-ui/react": "^5.0.0",
    "@auth/core": "^0.41.1",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@dagrejs/dagre": "^3.0.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@xyflow/react": "^12.10.2",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "openapi-fetch": "^0.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "start-authjs": "^1.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.10.0",
    "@playwright/test": "^1.49.1",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.6.0",
    "postcss": "^8.4.49",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
