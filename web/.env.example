# Copy this file to web/.env and fill in real values for local development.
# All variables are read at runtime by the TanStack Start server.

# Auth.js / cookie + JWT secret. Use a 32+ byte random string.
#   openssl rand -base64 32
AUTH_SECRET=replace-with-32+-byte-random-string

# Auth.js base URL — must include the auth path. Used by Auth.js for callback
# URL construction in development. In production, set this to the public origin.
AUTH_URL=http://localhost:3000/api/auth

# Generic OIDC provider settings — point at the same IdP that senko uses.
AUTH_OIDC_ISSUER=https://your-idp.example.com/realms/senko
AUTH_OIDC_CLIENT_ID=senko-web
AUTH_OIDC_CLIENT_SECRET=replace-me

# senko remote API base URL. The BFF proxy at /api/senko/* forwards to it.
SENKO_API_BASE_URL=http://localhost:8080

# Optional: override the Vite dev server port (default 3000).
WEB_DEV_PORT=3000

# Local-development convenience: when "true", the BFF proxy at /api/senko/*
# skips the Auth.js session check and forwards without an Authorization
# header, AND the root route injects a fake dev session so protected pages
# render without OIDC. Pair with `senko serve --dev-no-auth`. The combined
# launcher `mise run web:dev` (see web/README.md) sets this for you. Never
# enable in production.
WEB_DEV_AUTH_BYPASS=false

# --- Optional sign-in group/scope gate (Auth.js signIn callback) ---
# Reject sign-ins whose access_token does not satisfy the configured group/
# scope. All three unset (default) → all sign-ins are allowed (backward
# compatible). When any are set, missing or undecodable tokens fail-secure
# (sign-in rejected). When both are set, the gate is AND.
#
# Required OAuth scope. The access_token's `scope` claim (space-separated)
# must contain this exact value. Example for Cognito + APIGW resource-server
# scope: SENKO_AUTH_REQUIRED_SCOPE=senko:access
SENKO_AUTH_REQUIRED_SCOPE=

# Comma-separated allow-list of groups. The access_token's claim named by
# SENKO_AUTH_GROUPS_CLAIM must intersect this list (ANY match). Examples:
#   SENKO_AUTH_REQUIRED_GROUPS=senko
#   SENKO_AUTH_REQUIRED_GROUPS=senko,senko-admin
SENKO_AUTH_REQUIRED_GROUPS=

# Claim key holding the user's groups. No default — must be set when
# SENKO_AUTH_REQUIRED_GROUPS is set, otherwise startup logs a warning and
# all sign-ins are rejected (fail-secure). The claim value is parsed as a
# JSON array, comma-separated string, or whitespace-separated string. Common
# values per IdP:
#   - Cognito + pre-token Lambda injection: senko_groups
#   - Cognito standard:                     cognito:groups
#   - Keycloak (default mapper):            groups
SENKO_AUTH_GROUPS_CLAIM=
